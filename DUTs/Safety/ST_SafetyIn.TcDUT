<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_SafetyIn" Id="{0d1123b7-648b-0e04-09b5-2fa227393647}">
    <Declaration><![CDATA[//Selected input information used by the application.
TYPE ST_SafetyIn :
STRUCT
    stMCCStatusIn: ST_MCCStatusIn; //Decoded common cabinet status.
    stMCCCustomStatusIn: WORD; //Decoded application specific cabinet status.
    stLEDState: ST_LEDState; //Decoded PNOZ controller LED states.
    stPNOZCommDiag: ST_PNOZCommDiag; //EtherCAT communication diagnostics.
    astDiagnosticElementIn: ARRAY[1..GVL_APP.nNUM_OF_DIAGNOSTIC_ELEMENTS]
        OF ST_DiagnosticElementIn; //Selected diagnostic information from TxPDO_1.
    astTechnosoftMotionError: ARRAY[1..GVL_APP.nNUM_OF_TECHNOSOFT]
        OF ST_TechnosoftMotionError; //Decoded Technosoft drive errors.
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>