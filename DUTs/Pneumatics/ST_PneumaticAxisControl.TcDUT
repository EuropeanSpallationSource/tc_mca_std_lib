<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_PneumaticAxisControl" Id="{9b02699a-1208-07c7-0d58-2a295cd065b4}">
    <Declaration><![CDATA[TYPE ST_PneumaticAxisControl :
STRUCT
    bValveOn: BOOL; //Variable to control solenoid valve from PLC
    bValveOff: BOOL; //Variable to control solenoid valve from PLC
    bInterlockCyclic: BOOL; //Input interlock signal (resets end of cycle)
    bInterlockLatched: BOOL; //Input interlock signal (latches)
    bReset: BOOL; //Reset signal
    bValveOnManual: BOOL; //Variable to control the solenoid valve from the Operation Panel
    bValveOffManual: BOOL; //Variable to close the solenoid valve from the Operation Panel
END_STRUCT
END_TYPE

]]></Declaration>
  </DUT>
</TcPlcObject>