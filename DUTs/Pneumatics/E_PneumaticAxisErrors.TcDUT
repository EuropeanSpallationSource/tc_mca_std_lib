<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_PneumaticAxisErrors" Id="{19ddcca8-0a5d-0cc9-111b-bc14792f974a}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_PneumaticAxisErrors :
(
    eNoError := 0,
    eMovingWithValveOnTimedOut := 1, //Moving with valve on not done in expected time
    eMovingWithValveOffTimedOut := 2, //Moving with valve off not done in expected time
    eNotMovingWithValveOn := 3, //Moving with valve on not executed, cylinder stays in place
    eNotMovingWithValveOff := 4, //Moving with valve off not executed, cylinder stays in place
    eNoPSSPermit := 5, //Permit signal lost, and trying to move
    eValveOffInterlocked := 6, //Cylinder interlocked, but given signal to move with valve on
    eValveOnInterlocked := 7, //Cylinder interlocked, but given signal to move with valve off
    eAirPressureErrorLow := 8, //Air pressure too low
    eAirPressureErrorHigh := 9, //Air pressure too high
    eNoSignalFromEndSwitchValveOff := 10, //Lost signal from the EndSwitch of valve off
    eNoSignalFromEndSwitchValveOn := 11 //Lost signal from the EndSwitch of valve on
):= eNoError;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>