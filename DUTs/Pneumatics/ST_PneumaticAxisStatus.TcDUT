<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_PneumaticAxisStatus" Id="{834f971f-5bf6-0da5-0505-eb536ce0d2fb}">
    <Declaration><![CDATA[TYPE ST_PneumaticAxisStatus :
STRUCT
    bMovingWithValveOn: BOOL; //Moving with valve on status
    bMovingWithValveOff: BOOL; //Moving with valve off status
    bInPositionValveOn: BOOL; //In valve on position status
    bInPositionValveOff: BOOL; //In valve off postion status
    fTimeElapsedMovingWithValveOn: REAL; //Elapsed time while moving with valve on
    bTimeElapsedMovingWithValveOff: REAL; //Elapsed time while moving with valve off
    bSolenoid1Active: BOOL; //Status valve solenoid 1
	bSolenoid2Active: BOOL; //Status valve solenoid 2
    sStatus: STRING; //Pneumatic cylinder current status
    bInterlocked: BOOL; //Interlock siganl active
    bPSSPermitOK: BOOL; //Status of the PSS permit signal
    bAirPressureLow: BOOL; //Warning bit for the Low air pressure value
    bAirPressureHigh: BOOL; //Warning bit for the High air pressure value
    bError: BOOL; //Pneumatic axis is in Error state
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>