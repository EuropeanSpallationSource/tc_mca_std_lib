<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_TechnosoftMotionError" Id="{90598514-2df2-078a-0a1a-d8b0c6c1a1f5}">
    <Declaration><![CDATA[TYPE ST_TechnosoftMotionError :
STRUCT
    bit0_EtherCATCommunicationError: BIT; //EtherCAT communication error
    bit1_ShortCircuit: BIT; //Short circuit
    bit2_InvalidSetupData: BIT; //Invalid setup data
    bit3_ControlError: BIT; //Position or speed error
    bit4_CommunicationError: BIT; //Communication error
    bit5_FeedbackError: BIT; //Feedback error
    bit6_PositiveLimitSwitchActive: BIT; //Positive limit active
    bit7_NegativeLimitSwitchActive: BIT; //Negative limit active
    bit8_OverCurrent: BIT; //Over current
    bit9_I2TProtection: BIT; //I2T protection active
    bit10_MotorOverTemperature: BIT; //Motor over temperature
    bit11_DriveOverTemperature: BIT; //Drive over temperature
    bit12_OverVoltage: BIT; //Over voltage
    bit13_UnderVoltage: BIT; //Under voltage
    bit14_CommandError: BIT; //Command error
    bit15_STOActive: BIT; //Enabled or STO disabled
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>