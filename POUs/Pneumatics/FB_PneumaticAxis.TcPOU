<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PneumaticAxis" Id="{0ba43c5d-0b1b-4802-81a2-a56c90343a83}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PneumaticAxis

VAR
    _stPneumaticAxis: REFERENCE TO ST_PneumaticAxisStruct;
    _stConfig: REFERENCE TO ST_PneumaticAxisConfig;
    _stStatus: REFERENCE TO ST_PneumaticAxisStatus;
    _iPressureGroup: I_PressureGroup;

    eState: E_PneumaticAxisState := E_PneumaticAxisState.eDeenergized;
    eSetValveState: E_PneumaticAxisValveState := eVALVE_OFF;
    eActValveState: E_PneumaticAxisValveState := eVALVE_OFF;

    abEndSwitch: ARRAY [eVALVE_OFF..eVALVE_ON] OF BOOL;
    anMoveTimeLimit: ARRAY [eVALVE_OFF..eVALVE_ON] OF INT;
    abMoveCommand: ARRAY [eVALVE_OFF..eVALVE_ON] OF BOOL;
    atonMoving: ARRAY [eVALVE_OFF..eVALVE_ON] OF TON;
    afElapsedTime: ARRAY [eVALVE_OFF..eVALVE_ON] OF REAL;
    afElapsedTimeTotal: ARRAY [eVALVE_OFF..eVALVE_ON] OF REAL;

    bPSSPermitNeeded: BOOL;
    bPSSPermitMissing: BOOL;
    bInterlockRequest: BOOL;

    tonInitializeTimer: TON := (PT := tINIT);

    _eError: E_PneumaticAxisErrors := E_PneumaticAxisErrors.eNoError; //Current error, use property eError to GET/SET
    tonErrorAutoReset: TON := (PT := tAUTO_ERROR_RESET);
    rtrigReset: R_TRIG;
    artrigMoveCommand: ARRAY [eVALVE_OFF..eVALVE_ON] OF R_TRIG;
END_VAR
VAR CONSTANT
    eVALVE_OFF: E_PneumaticAxisValveState := E_PneumaticAxisValveState.eValveOff;
    eVALVE_ON: E_PneumaticAxisValveState := E_PneumaticAxisValveState.eValveOn;
    tINIT: TIME := T#3S;
    tAUTO_ERROR_RESET: TIME := T#3S;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
]]></ST>
    </Implementation>
    <Folder Name="Control Methods" Id="{39c4bcb2-31af-075e-197a-162c75539148}" />
    <Folder Name="Init Methods" Id="{8087fea6-af25-066c-2ec8-166e5ff52603}" />
    <Folder Name="Monitor Methods" Id="{1de9d575-2430-0608-3cc7-4848c696c067}" />
    <Folder Name="Properties" Id="{91a1fcf0-14fd-0997-1818-cca146c94024}" />
    <Property Name="bErrorPresent" Id="{e61928f7-5b1b-0cb8-323f-b7787336ed0f}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY bErrorPresent: BOOL
]]></Declaration>
      <Get Name="Get" Id="{4c00db51-9bfe-0487-2f10-0681dde6f968}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bErrorPresent := eError <> E_PneumaticAxisErrors.eNoError;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="eError" Id="{32047246-0707-0216-16bf-04057767b842}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY eError: E_PneumaticAxisErrors
]]></Declaration>
      <Get Name="Get" Id="{f3f6439d-58c8-0d64-1024-38a7f4d298fb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eError := _eError;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{915d3ea3-4659-00d6-29b2-9f1cbc8f96f8}">
        <Declaration><![CDATA[PRIVATE
VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF eError <> E_PneumaticAxisErrors.eNoError THEN
    _eError := eError;
END_IF
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="EndOfCycle" Id="{57491fe1-9ec0-014f-336a-f4f65c1d22e5}">
      <Declaration><![CDATA[METHOD PRIVATE EndOfCycle
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_stPneumaticAxis.stPneumaticAxisControl.bInterlockCyclic := FALSE;
_stPneumaticAxis.stPneumaticAxisControl.bReset := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="iPressureGroup" Id="{22d0755b-7b13-0cd9-272f-68eae7b24e53}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY iPressureGroup: I_PressureGroup
]]></Declaration>
      <Get Name="Get" Id="{9ea5e737-d543-0a73-2f8d-8db64b66adcb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[iPressureGroup := _iPressureGroup;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c7f592e7-b27b-0c07-3f42-42fbd40d1cc1}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_iPressureGroup := iPressureGroup;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="mControl_MoveTimer" Id="{b5c0d43d-0f0f-0b38-3402-746380f2c7c0}" FolderPath="Control Methods\">
      <Declaration><![CDATA[//Controls move timer and timing data
METHOD PRIVATE mControl_MoveTimer
VAR_INPUT
    eValve: E_PneumaticAxisValveState;
END_VAR
VAR
    bStart: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bStart := (eState = E_PneumaticAxisState.eMoving)
    AND (eValve = eSetValveState);

//Update Time
IF atonMoving[eValve].IN THEN
    afElapsedTime[eValve] := TIME_TO_REAL(atonMoving[eValve].ET) / 1000.0;

    IF NOT bStart THEN
        afElapsedTimeTotal[eValve] := afElapsedTime[eValve];
    END_IF
END_IF

//Call
atonMoving[eValve](
    IN := bStart,
    PT := INT_TO_TIME(anMoveTimeLimit[eValve] * 1000));

]]></ST>
      </Implementation>
    </Method>
    <Method Name="mControl_Reset" Id="{eb46ca39-d8bd-0f8f-0608-612e177641a1}" FolderPath="Control Methods\">
      <Declaration><![CDATA[//Controls error reset
METHOD PRIVATE mControl_Reset
VAR
    bAutoReset: BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Auto Reset
tonErrorAutoReset.IN := FALSE;
CASE eError OF
    E_PneumaticAxisErrors.eAirPressureErrorLow:
        tonErrorAutoReset.IN := NOT _iPressureGroup.bPressureLow;
        bAutoReset := tonErrorAutoReset.Q;

    E_PneumaticAxisErrors.eAirPressureErrorHigh:
        tonErrorAutoReset.IN := NOT _iPressureGroup.bPressureHigh;
        bAutoReset := tonErrorAutoReset.Q;

    E_PneumaticAxisErrors.eNoPSSPermit:
        bAutoReset := NOT bPSSPermitMissing;

    E_PneumaticAxisErrors.eNoSignalFromEndSwitchValveOff:
        bAutoReset := abEndSwitch[eVALVE_OFF]
            AND (_stConfig.ePneumaticAxisMode = E_PneumaticAxisMode.eMonostable);

    E_PneumaticAxisErrors.eEndSwitchSignalConflict:
        bAutoReset := NOT (abEndSwitch[eVALVE_OFF]
            AND abEndSwitch[eVALVE_ON]);

    E_PneumaticAxisErrors.eValveOffInterlocked,
    E_PneumaticAxisErrors.eValveOnInterlocked:
        bAutoReset := NOT bInterlockRequest;

END_CASE
tonErrorAutoReset();

//Manual Reset
rtrigReset(CLK := _stPneumaticAxis.stPneumaticAxisControl.bReset);

IF rtrigReset.Q OR bAutoReset THEN
    _eError := E_PneumaticAxisErrors.eNoError;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mControl_SetValveState" Id="{22b8f3fa-139b-0f55-370c-d7d4300933e5}" FolderPath="Control Methods\">
      <Declaration><![CDATA[//Controls set valve state
METHOD PRIVATE mControl_SetValveState
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState <> E_PneumaticAxisState.eMoving THEN
    eSetValveState := eActValveState;
END_IF

//Update set valve state
IF abMoveCommand[eVALVE_OFF]
    OR bPSSPermitMissing
THEN
    eSetValveState := eVALVE_OFF;
ELSIF abMoveCommand[eVALVE_ON]
    AND (eState <> E_PneumaticAxisState.eMoving)
THEN
    eSetValveState := eVALVE_ON;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mControl_State" Id="{5e029d34-6f19-0ae7-3102-4e3b30808b90}" FolderPath="Control Methods\">
      <Declaration><![CDATA[//Control state change requests
METHOD mControl_State
VAR_INPUT
    eNextState: E_PneumaticAxisState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Try to set initial state to standstill on init
IF tonInitializeTimer.Q THEN
    IF abEndSwitch[eVALVE_OFF]
        OR abEndSwitch[eVALVE_ON]
    THEN
        eNextState := E_PneumaticAxisState.eInPosition;
    END_IF
END_IF

//Change to next state, if no error present
IF bErrorPresent
    AND (eState <> E_PneumaticAxisState.eInterlocked)
THEN
    eState := E_PneumaticAxisState.eDeenergized;
ELSE
    eState := eNextState;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mInit" Id="{e75835b4-a332-075c-2fc7-dc7ebd157bc6}" FolderPath="Init Methods\">
      <Declaration><![CDATA[METHOD PRIVATE mInit: BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(_stPneumaticAxis) THEN
    RETURN;
END_IF

tonInitializeTimer();
IF tonInitializeTimer.Q THEN
    tonInitializeTimer.IN := FALSE;
END_IF

mInit := NOT tonInitializeTimer.IN;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mInputs" Id="{81f9e40e-e6f9-0de7-2c11-798b5a563dc2}">
      <Declaration><![CDATA[//Reads input variables and transforms them into internal variables
METHOD PRIVATE mInputs
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//References/Interfaces
_stConfig REF= _stPneumaticAxis.stPneumaticAxisConfig;
_stStatus REF= _stPneumaticAxis.stPneumaticAxisStatus;
_iPressureGroup := GVL.afbPressureGroup[_stConfig.eSelectPneumaticAxisGroup];

//PSS Permit
bPSSPermitNeeded := _stConfig.bSafetyShutter;

_stStatus.bPSSPermitOK := NOT bPSSPermitNeeded
    OR _stPneumaticAxis.stPneumaticAxisInputs.bPSSPermitOK;

bPSSPermitMissing := bPSSPermitNeeded
    AND (NOT _stPneumaticAxis.stPneumaticAxisInputs.bPSSPermitOK);

//Safety
_stStatus.bSafetyPermissionMissing := NOT _stConfig.bSafetyShutter
    AND NOT _stPneumaticAxis.stPneumaticAxisInputs.bSafetyPermission;

//Interlock
bInterlockRequest := (_stPneumaticAxis.stPneumaticAxisControl.bInterlockCyclic
    OR _stPneumaticAxis.stPneumaticAxisControl.bInterlockLatched)
    AND NOT _stConfig.bSafetyShutter;

//End Switch
abEndSwitch[eVALVE_OFF] := _stPneumaticAxis.stPneumaticAxisInputs.bEndSwitchValveOff;
abEndSwitch[eVALVE_ON] := _stPneumaticAxis.stPneumaticAxisInputs.bEndSwitchValveOn;

//Move Time
anMoveTimeLimit[eVALVE_OFF] := _stConfig.nTimeLimitMovingWithValveOff;
anMoveTimeLimit[eVALVE_ON] := _stConfig.nTimeLimitMovingWithValveOn;

//Move Command
artrigMoveCommand[eVALVE_OFF](
    CLK := _stPneumaticAxis.stPneumaticAxisControl.bValveOffManual
        OR _stPneumaticAxis.stPneumaticAxisControl.bValveOff);

abMoveCommand[eVALVE_OFF] := artrigMoveCommand[eVALVE_OFF].Q
    AND NOT _stStatus.bSafetyPermissionMissing;

artrigMoveCommand[eVALVE_ON](
    CLK := _stPneumaticAxis.stPneumaticAxisControl.bValveOnManual
        OR _stPneumaticAxis.stPneumaticAxisControl.bValveOn);

abMoveCommand[eVALVE_ON] := artrigMoveCommand[eVALVE_ON].Q
    AND NOT _stStatus.bSafetyPermissionMissing;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mMonitor_EndSwitch" Id="{8fe57045-97da-0040-2f5f-3113c2e4a645}" FolderPath="Monitor Methods\">
      <Declaration><![CDATA[//Monitor: End Switch
METHOD PRIVATE mMonitor_EndSwitch: E_PneumaticAxisErrors
VAR CONSTANT
    aERROR: ARRAY [eVALVE_OFF..eVALVE_ON] OF E_PneumaticAxisErrors := [
        E_PneumaticAxisErrors.eNoSignalFromEndSwitchValveOff,
        E_PneumaticAxisErrors.eNoSignalFromEndSwitchValveOn];
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT abEndSwitch[eActValveState] THEN
    mMonitor_EndSwitch := aERROR[eActValveState];
ELSIF abEndSwitch[eVALVE_OFF]
    AND abEndSwitch[eVALVE_ON]
THEN
    mMonitor_EndSwitch := E_PneumaticAxisErrors.eEndSwitchSignalConflict;
END_IF

eError := mMonitor_EndSwitch;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mMonitor_InterlockMove" Id="{5b74e8a2-afbb-097b-0a74-e3f8f8f7ad98}" FolderPath="Monitor Methods\">
      <Declaration><![CDATA[//Monitor: Interlock
METHOD PRIVATE mMonitor_InterlockMove: E_PneumaticAxisErrors
VAR CONSTANT
    aERROR: ARRAY [eVALVE_OFF..eVALVE_ON] OF E_PneumaticAxisErrors := [
        E_PneumaticAxisErrors.eValveOffInterlocked,
        E_PneumaticAxisErrors.eValveOnInterlocked];
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF abMoveCommand[eSetValveState]
    AND (eSetValveState <> eActValveState)
THEN
    mMonitor_InterlockMove := aERROR[eActValveState];
END_IF

eError := mMonitor_InterlockMove;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mMonitor_Move" Id="{759d2f8d-8e84-0713-216f-f31787094c5b}" FolderPath="Monitor Methods\">
      <Declaration><![CDATA[//Monitor: Move Timeout & No Movement
METHOD PRIVATE mMonitor_Move: E_PneumaticAxisErrors
VAR CONSTANT
    aERROR_TIMEOUT: ARRAY [eVALVE_OFF..eVALVE_ON] OF E_PneumaticAxisErrors := [
        E_PneumaticAxisErrors.eMovingWithValveOffTimedOut,
        E_PneumaticAxisErrors.eMovingWithValveOnTimedOut];
    aERROR_NO_MOVE: ARRAY [eVALVE_OFF..eVALVE_ON] OF E_PneumaticAxisErrors := [
        E_PneumaticAxisErrors.eNotMovingWithValveOff,
        E_PneumaticAxisErrors.eNotMovingWithValveOn];
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Timeout
IF atonMoving[eSetValveState].Q THEN
    IF abEndSwitch[eActValveState] THEN
        mMonitor_Move := aERROR_NO_MOVE[eSetValveState];
    ELSE
        mMonitor_Move := aERROR_TIMEOUT[eSetValveState];
    END_IF
END_IF

eError := mMonitor_Move;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mMonitor_Permit" Id="{1368e518-6934-07f8-2e25-d6a5ffa1a744}" FolderPath="Monitor Methods\">
      <Declaration><![CDATA[//Monitor: PSS Permit
METHOD PRIVATE mMonitor_Permit: E_PneumaticAxisErrors
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bPSSPermitMissing
    AND abMoveCommand[eVALVE_ON]
THEN
    mMonitor_Permit := E_PneumaticAxisErrors.eNoPSSPermit;
END_IF

eError := mMonitor_Permit;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mMonitor_Pressure" Id="{6586e859-2ea5-03c2-26ee-d35e5e7cbace}" FolderPath="Monitor Methods\">
      <Declaration><![CDATA[//Monitor: Pressure Low & High (Auto-Resets)
METHOD PRIVATE mMonitor_Pressure: E_PneumaticAxisErrors
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _iPressureGroup.bPressureLow THEN
    mMonitor_Pressure := E_PneumaticAxisErrors.eAirPressureErrorLow;
END_IF

IF _iPressureGroup.bPressureHigh THEN
    mMonitor_Pressure := E_PneumaticAxisErrors.eAirPressureErrorHigh;
END_IF

eError := mMonitor_Pressure;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mOutputs" Id="{e0f2114b-e095-0a99-3a69-d7ef5bca3c9b}">
      <Declaration><![CDATA[//Updates the status/output variables
METHOD PRIVATE mOutputs
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Actuate Solenoids
_stPneumaticAxis.stPneumaticAxisOutputs.bSolenoid14On :=
    //EITHER: Moving with Set ValveOn
    (eState = E_PneumaticAxisState.eMoving
    AND eSetValveState = E_PneumaticAxisValveState.eValveOn)
    //OR: InPosition / Interlocked in Act ValveOn
    OR ((eState = E_PneumaticAxisState.eInPosition
    OR eState = E_PneumaticAxisState.eInterlocked)
    AND eActValveState = E_PneumaticAxisValveState.eValveOn);

_stPneumaticAxis.stPneumaticAxisOutputs.bSolenoid12On :=
    //MUST: Bistable mode
    (_stConfig.ePneumaticAxisMode = E_PneumaticAxisMode.eBistable)
    //EITHER: Moving with Set ValveOff
    AND ((eState = E_PneumaticAxisState.eMoving
    AND eSetValveState = E_PneumaticAxisValveState.eValveOff)
    //OR: InPosition / Interlocked in Act ValveOff
    OR ((eState = E_PneumaticAxisState.eInPosition
    OR eState = E_PneumaticAxisState.eInterlocked)
    AND eActValveState = E_PneumaticAxisValveState.eValveOff));

//Pressure
_stStatus.bAirPressureLow := _iPressureGroup.bPressureLow;
_stStatus.bAirPressureHigh := _iPressureGroup.bPressureHigh;

//Valve Off
_stStatus.bInPositionValveOff := abEndSwitch[eVALVE_OFF];

_stStatus.bMovingWithValveOff :=
    (eState = E_PneumaticAxisState.eMoving)
    AND (eSetValveState = E_PneumaticAxisValveState.eValveOff);

_stStatus.fTimeElapsedMovingWithValveOff := afElapsedTime[eVALVE_OFF];

_stStatus.bSolenoid14Active :=
    _stPneumaticAxis.stPneumaticAxisOutputs.bSolenoid14On;

//Valve On
_stStatus.bInPositionValveOn := abEndSwitch[eVALVE_ON];

_stStatus.bMovingWithValveOn :=
    (eState = E_PneumaticAxisState.eMoving)
    AND (eSetValveState = E_PneumaticAxisValveState.eValveOn);

_stStatus.fTimeElapsedMovingWithValveOn := afElapsedTime[eVALVE_ON];

_stStatus.bSolenoid12Active :=
    _stPneumaticAxis.stPneumaticAxisOutputs.bSolenoid12On;

//Error
_stStatus.bError := bErrorPresent;
_stStatus.eError := eError;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mStatusInfo" Id="{e5a09ca1-5616-0a51-3f8d-aecba84ee10e}">
      <Declaration><![CDATA[//Maps the current state and errors into an status info text
METHOD PRIVATE mStatusInfo
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eError OF

    E_PneumaticAxisErrors.eAirPressureErrorLow:
        _stStatus.sStatus := 'ERROR: AIR PRESSURE TOO LOW';

    E_PneumaticAxisErrors.eAirPressureErrorHigh:
        _stStatus.sStatus := 'ERROR: AIR PRESSURE TOO HIGH';

    E_PneumaticAxisErrors.eNoSignalFromEndSwitchValveOff:
        _stStatus.sStatus := 'ERROR: NO SIGNAL FROM END SWITCH VALVE OFF';

    E_PneumaticAxisErrors.eNoSignalFromEndSwitchValveOn:
        _stStatus.sStatus := 'ERROR: NO SIGNAL FROM END SWITCH VALVE ON';

    E_PneumaticAxisErrors.eEndSwitchSignalConflict:
        _stStatus.sStatus := 'ERROR: SIGNAL FROM BOTH SWITCH HIGH';

    E_PneumaticAxisErrors.eNotMovingWithValveOff:
        _stStatus.sStatus := 'ERROR: VALVE OFF NOT MOVING';

    E_PneumaticAxisErrors.eNotMovingWithValveOn:
        _stStatus.sStatus := 'ERROR: VALVE ON NOT MOVING';

    E_PneumaticAxisErrors.eMovingWithValveOffTimedOut:
        _stStatus.sStatus := 'ERROR: VALVE OFF TIMEDOUT';

    E_PneumaticAxisErrors.eMovingWithValveOnTimedOut:
        _stStatus.sStatus := 'ERROR: VALVE ON TIMEDOUT';

    E_PneumaticAxisErrors.eValveOffInterlocked:
        _stStatus.sStatus := 'ERROR: VALVE OFF INTERLOCKED';

    E_PneumaticAxisErrors.eValveOnInterlocked:
        _stStatus.sStatus := 'ERROR: VALVE ON INTERLOCKED';

    E_PneumaticAxisErrors.eNoPSSPermit:
        _stStatus.sStatus := 'ERROR: NO PSS PERMIT';

    E_PneumaticAxisErrors.eNoError:
        CASE eState OF
            E_PneumaticAxisState.eDeenergized:
                _stStatus.sStatus := 'READY: DE-ENERGIZED';
            E_PneumaticAxisState.eInPosition:
                _stStatus.sStatus := 'READY: IN POSITION';
            E_PneumaticAxisState.eMoving:
                IF eSetValveState = E_PneumaticAxisValveState.eValveOn THEN
                    _stStatus.sStatus := 'MOVING: WITH VALVE ON';
                ELSE
                    _stStatus.sStatus := 'MOVING: WITH VALVE OFF';
                END_IF
            E_PneumaticAxisState.eInterlocked:
                _stStatus.sStatus := 'WARNING: INTERLOCK ON, CAN NOT MOVE';
        END_CASE

        IF _stStatus.bSafetyPermissionMissing THEN
            _stStatus.sStatus := 'WARNING: SAFETY PERMISSION MISSING';
        END_IF
    ELSE
        _stStatus.sStatus := 'UNKNOWN STATE';
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Run" Id="{4ff666c5-8aa4-4eaa-803d-5700cbef55c2}">
      <Declaration><![CDATA[METHOD PUBLIC Run
VAR
    eNextState: E_PneumaticAxisState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT mInit() THEN
    RETURN;
END_IF

mInputs();

mControl_MoveTimer(eValve := eVALVE_OFF);
mControl_MoveTimer(eValve := eVALVE_ON);
mControl_SetValveState();

mMonitor_Pressure();
mMonitor_Permit();

eNextState := eState;
CASE eState OF
    E_PneumaticAxisState.eDeenergized:
        IF abMoveCommand[eVALVE_OFF]
            OR abMoveCommand[eVALVE_ON]
        THEN
            eNextState := E_PneumaticAxisState.eMoving;
        ELSIF abEndSwitch[eVALVE_OFF] THEN
            eActValveState := eVALVE_OFF;
            eNextState := E_PneumaticAxisState.eInPosition;
        ELSIF abEndSwitch[eVALVE_ON] THEN
            eActValveState := eVALVE_ON;
            eNextState := E_PneumaticAxisState.eInPosition;
        END_IF

    E_PneumaticAxisState.eInPosition:
        mMonitor_EndSwitch();

        IF bInterlockRequest THEN
            eNextState := E_PneumaticAxisState.eInterlocked;
        ELSIF eSetValveState <> eActValveState THEN
            eNextState := E_PneumaticAxisState.eMoving;
        END_IF

    E_PneumaticAxisState.eMoving:
        mMonitor_Move();

        IF abEndSwitch[eSetValveState] THEN
            eActValveState := eSetValveState;
            eNextState := E_PneumaticAxisState.eInPosition;
        END_IF

    E_PneumaticAxisState.eInterlocked:
        mMonitor_InterlockMove();

        IF NOT bInterlockRequest THEN
            eNextState := E_PneumaticAxisState.eInPosition;
        END_IF
END_CASE

mControl_State(eNextState := eNextState);
mControl_Reset();

mStatusInfo();
mOutputs();

EndOfCycle();
]]></ST>
      </Implementation>
    </Method>
    <Property Name="stPneumaticAxis" Id="{32b385f3-2648-4c7a-b2e7-2316433a21ee}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY PUBLIC stPneumaticAxis: REFERENCE TO ST_PneumaticAxisStruct
]]></Declaration>
      <Get Name="Get" Id="{adb8011b-822d-0d9a-11a8-4f5c0c464fc5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[stPneumaticAxis REF= _stPneumaticAxis;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{83f042d6-81e0-4e48-8d59-f688cd15c5d1}">
        <Declaration><![CDATA[VAR
END_VAR
