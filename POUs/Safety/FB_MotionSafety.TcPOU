<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotionSafety" Id="{32c0b629-628f-083b-3fb5-c7c412be053b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotionSafety IMPLEMENTS I_SafetyProvider
VAR_INPUT
    bEnable: BOOL;
END_VAR
VAR_OUTPUT
    bDataValid: BOOL;
    bMCC_OK: BOOL;
    bAxisEnableAllowed: BOOL;
    bMCCWatchdogFault: BOOL;
END_VAR
VAR_IN_OUT
    stSafety: ST_Safety;
END_VAR
VAR
    _bEStopOK: BOOL;
    _bSTO_OK: BOOL;
    _bReadFromSafetyController: BOOL;

    i: UINT := 1; //Index for loops
    ftrigAxisEnableAllowed: F_TRIG;
    bInit: BOOL := TRUE;

    //Heartbeat
    tHeartbeatElapsed: TIME;
    tMCCWatchdogElapsed: TIME;
    bMCCHeartbeatInOld: BOOL;
    bMCCHeartbeatInit: BOOL;

    fbSafetyAcknowledgeLedPulse: FB_PulseGenerator;

    bInitPNOZ: BOOL := TRUE;
    fbPNOZData: FB_PNOZData; //Reads project and device data via table-segment requests.

    {attribute 'TcLinkTo' := 'TIID^Device 2 (EtherCAT)^KF509 (PNOZ m ES EtherCAT)^SmPdoVariables^PNOZ_m_ES_EtherCAT__2_2__SM_3^TxPDO_1'}
    stPNOZEtherCATDiagIn AT %I*: ST_PNOZEtherCATDiagIn; //Raw EtherCAT Input of TxPDO_1

    {attribute 'TcLinkTo' := 'TIID^Device 2 (EtherCAT)^KF509 (PNOZ m ES EtherCAT)^SmPdoVariables^PNOZ_m_ES_EtherCAT__2_2__SM_3^TxPDO'}
    stPNOZEtherCATIn AT %I*: ST_PNOZEtherCATIn; //Raw EtherCAT input of TxPDO

    {attribute 'TcLinkTo' := 'TIID^Device 2 (EtherCAT)^KF509 (PNOZ m ES EtherCAT)^SmPdoVariables^PNOZ_m_ES_EtherCAT__2_2__SM_2^RxPDO'}
    stPNOZEtherCATOut AT %Q*: ST_PNOZEtherCATOut; //Raw EtherCAT output of RxPDO

    {attribute 'TcLinkTo' :=  'TIID^Device 2 (EtherCAT)^KF509 (PNOZ m ES EtherCAT)^WcState^WcState'}
    bWcState AT %I*: BOOL;

    {attribute 'TcLinkTo' :=  'TIID^Device 2 (EtherCAT)^KF509 (PNOZ m ES EtherCAT)^InfoData^State'}
    nEtherCATState AT %I*: UINT; //State of EtherCAT slave
    sEtherCATState: STRING(10); //String to map states

    //Motion error registers from the Technosoft drives
    {attribute 'TcLinkTo' := '[1] := TIID^Device 2 (EtherCAT)^TA701 (iPOS8020 BX-CAT)^Transmit PDO 3 mapping parameters^Motion Error Register;
                              [2] := TIID^Device 2 (EtherCAT)^TA702 (iPOS8020 BX-CAT)^Transmit PDO 3 mapping parameters^Motion Error Register'}
    astTechnosoftMotionError AT %I*: ARRAY[1..GVL_APP.nNUM_OF_TECHNOSOFT] OF ST_TechnosoftMotionError;

    {attribute 'TcLinkTo' := 'TIID^Device 2 (EtherCAT)^KF201 (EK1100)^KF207 (EL2014)^DIG Outputs^Channel 3^Output'}
    bSafetyAcknowledgeLED AT %Q*: BOOL; //Cabinet status indicator
END_VAR
VAR CONSTANT
    tPLC_CYCLE_TIME: TIME := T#10MS; //PLC task cycle time
    tHEARTBEAT_PERIOD: TIME := T#200MS; //MCC heartbeat output period
    cHEARTBEAT_PW: LREAL := 50.0; //Heartbeat pulse width percentage
    tMCC_WATCHDOG_TIME: TIME := T#1S; //MCC watchdog timeout
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ IF NOT fbPNOZData.bInitDone THEN
    fbPNOZData(
    bInit := bInitPNOZ,
    nReturnedTable := stPNOZEtherCATIn.nTableNumber,
    nReturnedSegment := stPNOZEtherCATIn.nSegmentNumber,
    anSegmentData := stPNOZEtherCATIn.anSegmentByte,
    nRequestedTable => stPNOZEtherCATOut.nTableNumber,
    nRequestedSegment => stPNOZEtherCATOut.nSegmentNumber
    );
END_IF

_bReadFromSafetyController := bEnable;
stSafety.stIn.stPNOZCommDiag.bWcState := bWcState;
stSafety.stIn.stPNOZCommDiag.nEtherCATState := nEtherCATState;
bDataValid := FALSE;

IF NOT bEnable OR bWcState THEN
    bAxisEnableAllowed := FALSE; //Withdraw general motion permission
    _bEStopOK := FALSE; //Do not publish stale OK states
    _bSTO_OK := FALSE;

    bMCC_OK := mCheckMCCHeartbeat(
        bEnable := FALSE,
        bHeartbeatIn := FALSE,
        tTaskCycleTime := tPLC_CYCLE_TIME,
        tHeartbeatPeriod := tHEARTBEAT_PERIOD,
        fHeartbeatPW := cHEARTBEAT_PW,
        tWatchdogTime := tMCC_WATCHDOG_TIME,
        bHeartbeatOut => stSafety.stOut.stMCCStatus.bHeartbeat,
        bWatchdogFault => bMCCWatchdogFault
    ); //Reset heartbeat generation and watchdog memory

    stSafety.stOut.stMCCStatus.bErrorAcknowledge := FALSE; //Clear fault-acknowledge command
    mHandleMotionPermission(); //Process falling edge of motion permission
    RETURN;
END_IF;

mReadInputs(stSafetyIn := stSafety.stIn);
bDataValid := TRUE;

mMCCStatus(stSafetyData := stSafety); //Heartbeat generation, MCC watchdog check
//mTechnosoftStatus(stSafetyData := stSafety);

mUpdateFaultFeedback(stSafetyData := stSafety); //Fault/Err Ack. handshake
mHandleMotionPermission();
]]></ST>
    </Implementation>
    <Property Name="EStopOK" Id="{091ff546-d8eb-0d5e-357d-a3cab02108c2}">
      <Declaration><![CDATA[PROPERTY EStopOK : BOOL
]]></Declaration>
      <Get Name="Get" Id="{2846d572-a688-01b9-3c1a-4bb8c129c7da}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EStopOK := _bEStopOK;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="mCheckMCCHeartbeat" Id="{92bf9997-b495-087d-1b0e-cb488d1974e1}">
      <Declaration><![CDATA[METHOD mCheckMCCHeartbeat : BOOL
VAR_INPUT
    bEnable: BOOL;
    bHeartbeatIn: BOOL;
    tTaskCycleTime: TIME;
    tHeartbeatPeriod: TIME;
    fHeartbeatPW: LREAL; //Percent, e.g. 50.0
    tWatchdogTime: TIME;
END_VAR
VAR_OUTPUT
    bHeartbeatOut: BOOL;
    bWatchdogFault: BOOL;
END_VAR
VAR
    tHeartbeatOnTime: TIME;
    fPWClamped: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Disabled state
IF NOT bEnable THEN
    tHeartbeatElapsed := T#0MS;
    tMCCWatchdogElapsed := T#0MS;
    bMCCHeartbeatInit := FALSE;

    bHeartbeatOut := FALSE;
    bWatchdogFault := FALSE;

    mCheckMCCHeartbeat := FALSE;
    RETURN;
END_IF

//Clamp pulse width percentage
fPWClamped := fHeartbeatPW;
IF fPWClamped < 0.0 THEN
    fPWClamped := 0.0;
ELSIF fPWClamped > 100.0 THEN
    fPWClamped := 100.0;
END_IF

//Convert heartbeat period and pulse width into ON time
tHeartbeatOnTime := LREAL_TO_TIME(TIME_TO_LREAL(tHeartbeatPeriod) * fPWClamped / 100.0);

//Generate heartbeat output
tHeartbeatElapsed := tHeartbeatElapsed + tTaskCycleTime;

IF tHeartbeatElapsed >= tHeartbeatPeriod THEN
    tHeartbeatElapsed := tHeartbeatElapsed - tHeartbeatPeriod;
END_IF

bHeartbeatOut := tHeartbeatElapsed < tHeartbeatOnTime;

//Initialize watchdog memory on first enabled scan
IF NOT bMCCHeartbeatInit THEN
    bMCCHeartbeatInOld := bHeartbeatIn;
    tMCCWatchdogElapsed := T#0MS;
    bMCCHeartbeatInit := TRUE;
END_IF

//Watch incoming heartbeat for any change, rising or falling
IF bHeartbeatIn <> bMCCHeartbeatInOld THEN
    bMCCHeartbeatInOld := bHeartbeatIn;
    tMCCWatchdogElapsed := T#0MS;
ELSE
    IF tMCCWatchdogElapsed < tWatchdogTime THEN
        tMCCWatchdogElapsed := tMCCWatchdogElapsed + tTaskCycleTime;
    END_IF
END_IF

//Watchdog result
bWatchdogFault := tMCCWatchdogElapsed >= tWatchdogTime;

mCheckMCCHeartbeat := NOT bWatchdogFault;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mHandleMotionPermission" Id="{702967ef-f83e-0cc8-2e69-b0cc14a3fdac}">
      <Declaration><![CDATA[METHOD mHandleMotionPermission
VAR
    nAxis: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ftrigAxisEnableAllowed(CLK := bAxisEnableAllowed); //Detect falling edge of motion permission

IF ftrigAxisEnableAllowed.Q THEN
    FOR nAxis := 1 TO GVL_APP.nAXIS_NUM DO
        astAxes[nAxis].stControl.bEnable := FALSE; //Disable each axis once
    END_FOR;
END_IF;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mMCCStatus" Id="{da68ec2d-29dc-00ac-2b8b-5553d64c487d}">
      <Declaration><![CDATA[METHOD mMCCStatus
VAR_IN_OUT
    stSafetyData: ST_Safety;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bMCC_OK := mCheckMCCHeartbeat(
    bEnable := TRUE,
    bHeartbeatIn := stSafetyData.stIn.stMCCStatus.bHeartbeat,
    tTaskCycleTime := tPLC_CYCLE_TIME,
    tHeartbeatPeriod := tHEARTBEAT_PERIOD,
    fHeartbeatPW := cHEARTBEAT_PW,
    tWatchdogTime := tMCC_WATCHDOG_TIME,
    bHeartbeatOut => stSafetyData.stOut.stMCCStatus.bHeartbeat,
    bWatchdogFault => bMCCWatchdogFault
);

CASE nEtherCATState OF
    1: sEtherCATState := 'INIT';
    2: sEtherCATState := 'PRE_OP';
    3: sEtherCATState := 'BOOT';
    4: sEtherCATState := 'SAFE_OP';
    8: sEtherCATState := 'OP';
ELSE
    sEtherCATState := 'UNDEFINED';
END_CASE

bAxisEnableAllowed :=
    stSafetyData.stIn.stMCCStatus.bEStopOK
    AND bMCC_OK;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mReadInputs" Id="{c15732b0-7e08-06af-0803-936a25548168}">
      <Declaration><![CDATA[METHOD mReadInputs
VAR_IN_OUT
    stSafetyIn: ST_SafetyIn;
END_VAR
VAR
    nIndex: UINT; //Array index
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Common cabinet status: input bytes 00..01.
stSafetyIn.stMCCStatus.bHeartbeat := stPNOZEtherCATIn.nMCCStatus.0;
stSafetyIn.stMCCStatus.bAcknowledgeRequired := stPNOZEtherCATIn.nMCCStatus.1;
stSafetyIn.stMCCStatus.bFault := stPNOZEtherCATIn.nMCCStatus.2;
stSafetyIn.stMCCStatus.bWarning := stPNOZEtherCATIn.nMCCStatus.3;
stSafetyIn.stMCCStatus.bMessage := stPNOZEtherCATIn.nMCCStatus.4;
stSafetyIn.stMCCStatus.bEStopOK := stPNOZEtherCATIn.nMCCStatus.8;
stSafetyIn.stMCCStatus.bRemote := stPNOZEtherCATIn.nMCCStatus.9;

//Application specific: input bytes 02..03.
stSafetyIn.stMCCAppSpecific.abData[1] := stPNOZEtherCATIn.nMCCAppSpecific.0;
stSafetyIn.stMCCAppSpecific.abData[2] := stPNOZEtherCATIn.nMCCAppSpecific.1;
stSafetyIn.stMCCAppSpecific.abData[3] := stPNOZEtherCATIn.nMCCAppSpecific.2;
stSafetyIn.stMCCAppSpecific.abData[4] := stPNOZEtherCATIn.nMCCAppSpecific.3;
stSafetyIn.stMCCAppSpecific.abData[5] := stPNOZEtherCATIn.nMCCAppSpecific.4;
stSafetyIn.stMCCAppSpecific.abData[6] := stPNOZEtherCATIn.nMCCAppSpecific.5;
stSafetyIn.stMCCAppSpecific.abData[7] := stPNOZEtherCATIn.nMCCAppSpecific.6;
stSafetyIn.stMCCAppSpecific.abData[8] := stPNOZEtherCATIn.nMCCAppSpecific.7;

stSafetyIn.stMCCAppSpecific.abValid[1] := stPNOZEtherCATIn.nMCCAppSpecific.8;
stSafetyIn.stMCCAppSpecific.abValid[2] := stPNOZEtherCATIn.nMCCAppSpecific.9;
stSafetyIn.stMCCAppSpecific.abValid[3] := stPNOZEtherCATIn.nMCCAppSpecific.10;
stSafetyIn.stMCCAppSpecific.abValid[4] := stPNOZEtherCATIn.nMCCAppSpecific.11;
stSafetyIn.stMCCAppSpecific.abValid[5] := stPNOZEtherCATIn.nMCCAppSpecific.12;
stSafetyIn.stMCCAppSpecific.abValid[6] := stPNOZEtherCATIn.nMCCAppSpecific.13;
stSafetyIn.stMCCAppSpecific.abValid[7] := stPNOZEtherCATIn.nMCCAppSpecific.14;
stSafetyIn.stMCCAppSpecific.abValid[8] := stPNOZEtherCATIn.nMCCAppSpecific.15;

//Controller LED states: input byte 16.
stSafetyIn.stLEDState.bOutputFault := stPNOZEtherCATIn.nLEDState.0;
stSafetyIn.stLEDState.bInputFault := stPNOZEtherCATIn.nLEDState.1;
stSafetyIn.stLEDState.bFault := stPNOZEtherCATIn.nLEDState.2;
stSafetyIn.stLEDState.bDiag := stPNOZEtherCATIn.nLEDState.3;
stSafetyIn.stLEDState.bRun := stPNOZEtherCATIn.nLEDState.4;

//TODO! Clean this up
stSafetyIn.stFieldbusData.stLEDState.bPower := F_IsLowNibbleSet(stPNOZEtherCATDiagIn.anFieldbusModuleLED[1]);
stSafetyIn.stFieldbusData.stLEDState.bRun := F_IsHighNibbleSet(stPNOZEtherCATDiagIn.anFieldbusModuleLED[1]);
stSafetyIn.stFieldbusData.stLEDState.bFault := F_IsHighNibbleSet(stPNOZEtherCATDiagIn.anFieldbusModuleLED[2]);


stSafetyIn.stBaseModuleData.stLEDState.bPower := F_IsLowNibbleSet(stPNOZEtherCATDiagIn.anBaseModuleLED[1]);
stSafetyIn.stBaseModuleData.stLEDState.bRun := F_IsHighNibbleSet(stPNOZEtherCATDiagIn.anBaseModuleLED[1]);
stSafetyIn.stBaseModuleData.stLEDState.bDiag := F_IsLowNibbleSet(stPNOZEtherCATDiagIn.anBaseModuleLED[2]);
stSafetyIn.stBaseModuleData.stLEDState.bFault := F_IsHighNibbleSet(stPNOZEtherCATDiagIn.anBaseModuleLED[2]);
stSafetyIn.stBaseModuleData.stLEDState.bInputFault := F_IsLowNibbleSet(stPNOZEtherCATDiagIn.anBaseModuleLED[3]);
stSafetyIn.stBaseModuleData.stLEDState.bOutputFault := F_IsHighNibbleSet(stPNOZEtherCATDiagIn.anBaseModuleLED[3]);
stSafetyIn.stBaseModuleData.anInput[1] := stPNOZEtherCATDiagIn.anBaseModuleInput[1];
stSafetyIn.stBaseModuleData.anInput[2] := stPNOZEtherCATDiagIn.anBaseModuleInput[2];
stSafetyIn.stBaseModuleData.anInput[3] := stPNOZEtherCATDiagIn.anBaseModuleInput[3];
stSafetyIn.stBaseModuleData.anOutput[1] := stPNOZEtherCATDiagIn.anBaseModuleOutput[1];
stSafetyIn.stBaseModuleData.anOutput[2] := stPNOZEtherCATDiagIn.anBaseModuleOutput[2];

FOR nIndex := 1 TO GVL_APP.nNUM_OF_EXPANSION_LEFT BY 1 DO
    stSafetyIn.astExpansionModuleLeftData[nIndex].stLEDState.bPower :=
        F_IsLowNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleLeft[nIndex].anLEDState[1]);
    stSafetyIn.astExpansionModuleLeftData[nIndex].stLEDState.bRun :=
        F_IsHighNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleLeft[nIndex].anLEDState[1]);
    stSafetyIn.astExpansionModuleLeftData[nIndex].stLEDState.bDiag :=
        F_IsLowNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleLeft[nIndex].anLEDState[2]);
    stSafetyIn.astExpansionModuleLeftData[nIndex].stLEDState.bFault :=
        F_IsHighNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleLeft[nIndex].anLEDState[2]);
    stSafetyIn.astExpansionModuleLeftData[nIndex].stLEDState.bInputFault :=
        F_IsLowNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleLeft[nIndex].anLEDState[3]);
    stSafetyIn.astExpansionModuleLeftData[nIndex].stLEDState.bOutputFault :=
        F_IsHighNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleLeft[nIndex].anLEDState[3]);
    stSafetyIn.astExpansionModuleLeftData[nIndex].anInput :=
        stPNOZEtherCATDiagIn.astExpansionModuleLeft[nIndex].anInput;
    stSafetyIn.astExpansionModuleLeftData[nIndex].anOutput :=
        stPNOZEtherCATDiagIn.astExpansionModuleLeft[nIndex].anOutput;
END_FOR

FOR nIndex := 1 TO GVL_APP.nNUM_OF_EXPANSION_RIGHT BY 1 DO
    stSafetyIn.astExpansionModuleRightData[nIndex].stLEDState.bPower :=
        F_IsLowNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleRight[nIndex].anLEDState[1]);
    stSafetyIn.astExpansionModuleRightData[nIndex].stLEDState.bRun :=
        F_IsHighNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleRight[nIndex].anLEDState[1]);
    stSafetyIn.astExpansionModuleRightData[nIndex].stLEDState.bDiag :=
        F_IsLowNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleRight[nIndex].anLEDState[2]);
    stSafetyIn.astExpansionModuleRightData[nIndex].stLEDState.bFault :=
        F_IsHighNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleRight[nIndex].anLEDState[2]);
    stSafetyIn.astExpansionModuleRightData[nIndex].stLEDState.bInputFault :=
        F_IsLowNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleRight[nIndex].anLEDState[3]);
    stSafetyIn.astExpansionModuleRightData[nIndex].stLEDState.bOutputFault :=
        F_IsHighNibbleSet(stPNOZEtherCATDiagIn.astExpansionModuleRight[nIndex].anLEDState[3]);
    stSafetyIn.astExpansionModuleRightData[nIndex].anInput[1] :=
        stPNOZEtherCATDiagIn.astExpansionModuleRight[nIndex].nInput;
    stSafetyIn.astExpansionModuleRightData[nIndex].anOutput[1] :=
        stPNOZEtherCATDiagIn.astExpansionModuleRight[nIndex].nOutput;
END_FOR

//Decode diagnostic elements from TxPDO_1.
FOR nIndex := 1 TO GVL_APP.nMAX_DIAGNOSTIC_ELEMENTS DO
    stSafetyIn.astDiagnosticElement[nIndex].bPulseTestError :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nHigh.b0;

    stSafetyIn.astDiagnosticElement[nIndex].bIn1 :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nHigh.b4;

    stSafetyIn.astDiagnosticElement[nIndex].bIn2 :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nHigh.b5;

    stSafetyIn.astDiagnosticElement[nIndex].bIn3 :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nHigh.b6;

    stSafetyIn.astDiagnosticElement[nIndex].bIn4 :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nHigh.b7;

    stSafetyIn.astDiagnosticElement[nIndex].bActive :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nLow.b0;

    stSafetyIn.astDiagnosticElement[nIndex].bSafe :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nLow.b1;

    stSafetyIn.astDiagnosticElement[nIndex].bReady :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nLow.b2;

    stSafetyIn.astDiagnosticElement[nIndex].bTestReq :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nLow.b3;

    stSafetyIn.astDiagnosticElement[nIndex].bOperatedLate :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nLow.b4;

    stSafetyIn.astDiagnosticElement[nIndex].bSwitchError :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nLow.b5;

    stSafetyIn.astDiagnosticElement[nIndex].bDisabled :=
        stPNOZEtherCATDiagIn.astDiagnosticElementsIn[nIndex].nLow.b6;
END_FOR

//Motion error registers from the Technosoft drives.
IF GVL_APP.nNUM_OF_TECHNOSOFT <> 0 THEN
    FOR nIndex := 1 TO GVL_APP.nNUM_OF_TECHNOSOFT DO
        stSafetyIn.astTechnosoftMotionError[nIndex] :=
            astTechnosoftMotionError[nIndex];
    END_FOR
END_IF

//Used internally in this function block.
_bEStopOK := stSafetyIn.stMCCStatus.bEStopOK;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mTechnosoftStatus" Id="{84e199c5-d03a-07aa-3ac5-dfb44e9a37dd}">
      <Declaration><![CDATA[METHOD mTechnosoftStatus
VAR_IN_OUT
    stSafetyData: ST_Safety;
END_VAR
VAR
    nAxes: UINT;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Evaluate Technosoft STO states and motion errors
stSafetyData.stOut.bSTOActive := FALSE;
stSafetyData.stOut.bTechnosoftMotionErrors := FALSE;

IF GVL_APP.nNUM_OF_TECHNOSOFT <> 0 THEN
    FOR nAxes := 1 TO GVL_APP.nNUM_OF_TECHNOSOFT DO
        stSafetyData.stOut.bSTOActive :=
            stSafetyData.stOut.bSTOActive
            OR stSafetyData.stIn.astTechnosoftMotionError[nAxes].bSTOActive;

        stSafetyData.stOut.bTechnosoftMotionErrors :=
            stSafetyData.stOut.bTechnosoftMotionErrors
            OR F_TechnosoftErrorActive(stError := stSafetyData.stIn.astTechnosoftMotionError[nAxes]);
    END_FOR
END_IF

IF GVL_APP.nNUM_OF_TECHNOSOFT <> 0 THEN
//    stSafetyData.stSafetyOut.stMCCStatusOut.bSTOFbk :=
//        stSafetyData.stSafetyOut.bSTOActive; //TRUE when any Technosoft drive reports STO active

//    stSafetyData.stSafetyOut.stMCCStatusOut.bSTO_OK :=
//        NOT stSafetyData.stSafetyOut.bTechnosoftMotionErrors; //Preserve the existing no-motion-error feedback
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mUpdateFaultFeedback" Id="{8d545eee-7262-0343-278e-9ff04052f842}">
      <Declaration><![CDATA[METHOD mUpdateFaultFeedback
VAR_IN_OUT
    stSafetyData: ST_Safety;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Fault feedback to safety controller.
stSafetyData.stOut.stMCCStatus.bErrorAcknowledge :=
    stSafetyData.stIn.stMCCStatus.bFault;

//Watchdog fault: triple flash. Acknowledgment required: single flash.
fbSafetyAcknowledgeLedPulse(
    bEnable := bMCCWatchdogFault OR stSafetyData.stIn.stMCCStatus.bAcknowledgeRequired,
    tFlashPeriod := T#1S,
    tOffTime := SEL(bMCCWatchdogFault, T#500MS, T#100MS),
    tOnTime := SEL(bMCCWatchdogFault, T#500MS, T#100MS),
    nFlashCount := SEL(bMCCWatchdogFault, 1, 3)
);

//Watchdog fault or acknowledgment required: use flashing output.
IF bMCCWatchdogFault OR stSafetyData.stIn.stMCCStatus.bAcknowledgeRequired THEN
    bSafetyAcknowledgeLED := fbSafetyAcknowledgeLedPulse.bOut;
ELSE
    bSafetyAcknowledgeLED := stSafetyData.stIn.stMCCStatus.bFault; //Fault only: solid. No fault: off.
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mWriteOutputs" Id="{38cfbe25-cd48-0fa9-1b38-9c18bd912579}">
      <Declaration><![CDATA[METHOD mWriteOutputs : BOOL
VAR_INPUT
    stSafetyOut: ST_SafetyOut;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Initialize common commands; unused bits remain FALSE.
stPNOZEtherCATOut.nMCCStatus := WORD#0;

//Encode common cabinet commands.
stPNOZEtherCATOut.nMCCStatus.0 := stSafetyOut.stMCCStatus.bHeartbeat;

stPNOZEtherCATOut.nMCCStatus.1 := stSafetyOut.stMCCStatus.bPLC_OK;

stPNOZEtherCATOut.nMCCStatus.2 := stSafetyOut.stMCCStatus.bErrorAcknowledge;

//No custom commands are currently defined.
stPNOZEtherCATOut.nMCCCustomStatus := WORD#0;

//Digital outputs are currently unused.
FOR i := 1 TO SIZEOF(stPNOZEtherCATOut.anDigitalOutputs) DO
    stPNOZEtherCATOut.anDigitalOutputs[i] := BYTE#0;
END_FOR

//Safe output groups are currently unused.
FOR i := 1 TO SIZEOF(stPNOZEtherCATOut.anSafeOutputGroups) DO
    stPNOZEtherCATOut.anSafeOutputGroups[i] := BYTE#0;
END_FOR

//Preserve the existing internal STO assignment.
_bSTO_OK := stSafetyOut.bSTOActive;
]]></ST>
      </Implementation>
    </Method>
