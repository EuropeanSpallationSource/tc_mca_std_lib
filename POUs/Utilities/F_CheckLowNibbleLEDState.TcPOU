<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="F_CheckLowNibbleLEDState" Id="{c6dd8d8f-cdc8-06f6-20dd-7f5d2737e40d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_CheckLowNibbleLEDState : BOOL
VAR_IN_OUT CONSTANT
    nValue: BYTE;
END_VAR
VAR_INPUT
    bFlashOn: BOOL;
END_VAR
VAR
    nNibble: BYTE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[nNibble := nValue AND BYTE#16#0F;
F_CheckLowNibbleLEDState := (nNibble <> BYTE#0) AND ((nNibble <> BYTE#3) OR bFlashOn);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>