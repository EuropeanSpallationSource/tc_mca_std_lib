<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_EL7047_Tuner" Id="{2768c7ae-4a0c-4a4c-8b12-4d3efb5f2e6e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EL7047_Tuner
VAR_INPUT
    _stAxis             : REFERENCE TO ST_AxisStruct;
    stTuningInputs      : ST_Tuning;

    // Intelligent Auto-Tune Parameters
    bExecuteAutoTune    : BOOL;
    bStepMode           : BOOL; // If TRUE, pauses after each pass
    bNextStep           : BOOL; // Trigger to proceed to the next pass
    nKpStartOverride    : UINT := 150;    // If > 0, overrides the L calculation (Beckhoff default is 150)
    nMaxCurrent_mA      : UINT := 0;      // 0x8010:01. If 0, the block reads the existing CoE value natively

    // Resonance Testing Velocity Range
    fTestVelocity       : LREAL := 7.5;   // Velocity where resonance occurs
    fTestDistance       : LREAL := 50.0;  // Distance to travel for measuring

    // Tuning Constraints
    fTnMin              : REAL := 0.3;    // ms
    fTnMax              : REAL := 1.0;    // ms
    nKiStart            : UINT := 1;
    nKiEnd              : UINT := 20;
    nKiStep             : UINT := 1;
    fKpReductionPct     : LREAL := 10.0;  // Reduce Kp by 10% per major loop
    nMaxKpIterations    : UINT := 5;      // How many times to reduce Kp

    // Manual Mode (Python ADS Server)
    bExecuteSingleTest  : BOOL; // Python triggers this to run just one pass and fill the array

    // Manual Parameter Application (HMI Staging Area)
    bApplyParams        : BOOL; // Trigger to write Staging Area to the drive
    nApplyMaxCurrent    : UINT; // The Current to write (auto-filled with CurrentRun after tuning)
    nApplyKp            : UINT; // The Kp to write (auto-filled with BestKp after tuning)
    nApplyKi            : UINT; // The Ki to write (auto-filled with BestKi after tuning)

    // Baseline Snapshot (HMI)
    bSaveBaseline       : BOOL; // Trigger to lock the current Best into the Baseline arrays
    bLoadBaseline       : BOOL; // Trigger to copy Baseline values into the Staging Area

    // Error Handling
    bContinueAfterError : BOOL; // Retry the failed step from the HMI
    bAbortTuning        : BOOL; // Abort tuning and return to Idle
END_VAR
VAR_OUTPUT
    bBusy               : BOOL;
    bDone               : BOOL;
    bIterationReady     : BOOL; // Handshake: TRUE when waiting for Python to read data
    bError              : BOOL;
    nErrorId            : UDINT;

    // Run Results (Current Sweep)
    nCurrentRunMaxCurrent: UINT; // Shows what current was actually used for this test
    nBestKp             : UINT;
    nBestKi             : UINT;
    fBestResonanceScore : LREAL;

    nWorstKp            : UINT;
    nWorstKi            : UINT;
    fWorstResonanceScore: LREAL;

    // Baseline Snapshot (Manually saved)
    nBaselineMaxCurrent : UINT;
    nBaselineKp         : UINT;
    nBaselineKi         : UINT;
    fBaselineScore      : LREAL;
END_VAR
VAR
    // The high-speed 1ms buffer for ADS extraction or internal analysis
    aLoadData           : ARRAY[1..1000] OF INT; // InfoData 1 (Current Run)
    aBestLoadData       : ARRAY[1..1000] OF INT; // InfoData 1 (Best Run Snapshot)
    aWorstLoadData      : ARRAY[1..1000] OF INT; // InfoData 1 (Worst Run Snapshot)
    aBaselineLoadData   : ARRAY[1..1000] OF INT; // InfoData 1 (Locked Baseline Snapshot)

    aPowerData          : ARRAY[1..1000] OF INT; // InfoData 2
    nSampleCount        : UINT;

    // Internal State Machine and Motion Blocks
    eState              : E_TunerState;
    eNextState          : E_TunerState;
    eErrorSource        : E_TunerState; // Stores where the error occurred for retrying
    fbCoEWrite          : FB_EcCoESdoWrite;
    fbCoERead           : FB_EcCoESdoRead;
    fbMoveRelative      : MC_MoveRelative;
    fbSettleTimer       : TON;
    fbReadStatus        : MC_ReadStatus;

    // Loop trackers and internal calculations
    fMotorInductance    : LREAL; // Fetched natively from CoE
    nCurrentKp          : UINT;
    nCurrentKi          : UINT;
    nIteration          : UINT;
    fCurrentTn          : REAL;
    fCurrentResonance   : LREAL; // Will now store Variance instead of Peak-to-Peak

    // Diagnostic History Log
    aTuningHistory      : ARRAY[1..500] OF ST_TuningLog;
    nLogCount           : UINT;

    // CoE buffer
    nCoEWriteBuffer     : UINT;
    nTnCoEBuffer        : UINT;
    nCoEInductanceBuf   : UINT;

    // Math evaluation
    i                   : UINT;
    nMaxLoad            : INT; // Kept for visual reference if needed
    nMinLoad            : INT;
    fCurrentResonance   : LREAL; // Will now store Variance instead of Peak-to-Peak

    nStartIndex         : UINT;
    nEndIndex           : UINT;
    nWindowSize         : UINT;
    fSum                : LREAL;
    fMean               : LREAL;
    fVarianceSum        : LREAL;
    fDiff               : LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Initialize FB parameters
fbCoEWrite(sNetId := _stAxis.stConfig.stCoEParameters.sEthCATNetId, nSlaveAddr := _stAxis.stConfig.stCoEParameters.nSlaveAdressDrive);
fbCoERead(sNetId := _stAxis.stConfig.stCoEParameters.sEthCATNetId, nSlaveAddr := _stAxis.stConfig.stCoEParameters.nSlaveAdressDrive);
fbMoveRelative(Axis := _stAxis.Axis, Velocity := fTestVelocity);
fbReadStatus(Axis := _stAxis.Axis, Enable := TRUE);

// Manual Baseline Trigger
IF bSaveBaseline THEN
    bSaveBaseline := FALSE;
    nBaselineMaxCurrent := nCurrentRunMaxCurrent;
    nBaselineKp := nBestKp;
    nBaselineKi := nBestKi;
    fBaselineScore := fBestResonanceScore;
    MEMCPY(ADR(aBaselineLoadData), ADR(aBestLoadData), SIZEOF(aBestLoadData));
END_IF

// Load Baseline to Staging Area
IF bLoadBaseline THEN
    bLoadBaseline := FALSE;
    nApplyMaxCurrent := nBaselineMaxCurrent;
    nApplyKp := nBaselineKp;
    nApplyKi := nBaselineKi;
END_IF

// Global Abort Override
IF bAbortTuning THEN
    bAbortTuning := FALSE;
    bBusy := FALSE;
    bError := FALSE;
    bIterationReady := FALSE;
    fbCoERead.bExecute := FALSE;
    fbCoEWrite.bExecute := FALSE;
    fbMoveRelative.Execute := FALSE;

    // If we are actively testing and moving, halt the motor instantly
    IF eState >= E_TunerState.eMoveFwd AND eState <= E_TunerState.eWaitMoveBwd THEN
        _stAxis.stControl.bStop := TRUE;
    END_IF

    eState := E_TunerState.eIdle;
END_IF

CASE eState OF
    E_TunerState.eIdle:
        IF bExecuteAutoTune THEN
            bBusy := TRUE;
            bDone := FALSE;
            bError := FALSE;
            bIterationReady := FALSE;
            nErrorId := 0;
            nIteration := 0;
            fBestResonanceScore := 999999999.0;
            fWorstResonanceScore := 0.0;
            bNextStep := FALSE;
            
            nLogCount := 0;
            MEMSET(ADR(aTuningHistory), 0, SIZEOF(aTuningHistory));

            // Prevent infinite scan loops if user sets step to 0
            IF nKiStep < 1 THEN
                nKiStep := 1;
            END_IF

            IF nKpStartOverride = 0 THEN
                eState := E_TunerState.eReadInductance;
            ELSE
                IF nMaxCurrent_mA = 0 THEN
                    eState := E_TunerState.eReadMaxCurrent;
                ELSE
                    nCurrentRunMaxCurrent := nMaxCurrent_mA;
                    eState := E_TunerState.eWriteMaxCurrent;
                END_IF
            END_IF

        ELSIF bExecuteSingleTest THEN
            // Manual single-shot mode (for Python plotting)
            bBusy := TRUE;
            bDone := FALSE;
            bError := FALSE;
            nSampleCount := 0;
            MEMSET(ADR(aLoadData), 0, SIZEOF(aLoadData));
            MEMSET(ADR(aPowerData), 0, SIZEOF(aPowerData));

            fbMoveRelative.Distance := fTestDistance;
            fbMoveRelative.Execute := TRUE;
            eState := E_TunerState.eMoveFwd;

        ELSIF bApplyParams THEN
            // HMI Manual Application of Params
            bBusy := TRUE;
            bDone := FALSE;
            bError := FALSE;
            eState := E_TunerState.eApplyManualCurrent;
        END_IF

    E_TunerState.eReadInductance:
        fbCoERead.nIndex := 16#8011;
        fbCoERead.nSubIndex := 16#1C;
        fbCoERead.pDstBuf := ADR(nCoEInductanceBuf);
        fbCoERead.cbBufLen := SIZEOF(nCoEInductanceBuf);
        
        IF NOT fbCoERead.bExecute THEN
            fbCoERead.bExecute := TRUE;
        ELSIF NOT fbCoERead.bBusy AND NOT fbCoERead.bError THEN
            fbCoERead.bExecute := FALSE;
            // Inductance is given in 0.01 mH resolution. Convert to Henries.
            fMotorInductance := UINT_TO_REAL(nCoEInductanceBuf) * 0.00001;
            
            IF nMaxCurrent_mA = 0 THEN
                eState := E_TunerState.eReadMaxCurrent;
            ELSE
                nCurrentRunMaxCurrent := nMaxCurrent_mA;
                eState := E_TunerState.eWriteMaxCurrent;
            END_IF
        ELSIF fbCoERead.bError THEN
            eErrorSource := eState;
            nErrorId := fbCoERead.nErrId;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eReadMaxCurrent:
        fbCoERead.nIndex := 16#8010;
        fbCoERead.nSubIndex := 16#01;
        fbCoERead.pDstBuf := ADR(nCurrentRunMaxCurrent);
        fbCoERead.cbBufLen := SIZEOF(nCurrentRunMaxCurrent);
        IF NOT fbCoERead.bExecute THEN
            fbCoERead.bExecute := TRUE;
        ELSIF NOT fbCoERead.bBusy AND NOT fbCoERead.bError THEN
            fbCoERead.bExecute := FALSE;
            IF nKpStartOverride = 0 THEN
                eState := E_TunerState.eCalcStartKp;
            ELSE
                nCurrentKp := nKpStartOverride;
                nCurrentKi := nKiStart;
                eState := E_TunerState.eWriteKp;
            END_IF
        ELSIF fbCoERead.bError THEN
            eErrorSource := eState;
            nErrorId := fbCoERead.nErrId;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eWriteMaxCurrent:
        fbCoEWrite.nIndex := 16#8010;
        fbCoEWrite.nSubIndex := 16#01;
        nCoEWriteBuffer := nCurrentRunMaxCurrent;
        fbCoEWrite.pSrcBuf := ADR(nCoEWriteBuffer);
        fbCoEWrite.cbBufLen := SIZEOF(nCoEWriteBuffer);
        IF NOT fbCoEWrite.bExecute THEN
            fbCoEWrite.bExecute := TRUE;
        ELSIF NOT fbCoEWrite.bBusy AND NOT fbCoEWrite.bError THEN
            fbCoEWrite.bExecute := FALSE;
            IF nKpStartOverride = 0 THEN
                eState := E_TunerState.eCalcStartKp;
            ELSE
                nCurrentKp := nKpStartOverride;
                nCurrentKi := nKiStart;
                eState := E_TunerState.eEvaluateTn;
            END_IF
        ELSIF fbCoEWrite.bError THEN
            nErrorId := fbCoEWrite.nErrId;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eCalcStartKp:
        // Kp = 10000 * 2pi * L
        nCurrentKp := LREAL_TO_UINT(10000.0 * 2.0 * 3.14159265359 * fMotorInductance);
        nCurrentKi := nKiStart;
        eState := E_TunerState.eEvaluateTn;

    E_TunerState.eEvaluateTn:
        // Always reset the sample count for the new iteration
        nSampleCount := 0;

        // Calculate Tn directly in the PLC instead of waiting for the drive firmware!
        // EL7047 Math: Tn (ms) = (Kp / Ki) * 0.294
        IF nCurrentKi > 0 THEN
            fCurrentTn := (UINT_TO_REAL(nCurrentKp) / UINT_TO_REAL(nCurrentKi)) * 0.294;
        ELSE
            fCurrentTn := 0.0;
        END_IF
        
        // Create a new Log Entry
        IF nLogCount < 500 THEN
            nLogCount := nLogCount + 1;
            aTuningHistory[nLogCount].nKp := nCurrentKp;
            aTuningHistory[nLogCount].nKi := nCurrentKi;
            aTuningHistory[nLogCount].fCalculatedTn := fCurrentTn;
            aTuningHistory[nLogCount].fResonanceScore := 0.0; // Reset score
        END_IF

        // Enforce Beckhoff bounds (0.3 to 1.0 ms)
        IF fCurrentTn >= fTnMin AND fCurrentTn <= fTnMax THEN
            IF nLogCount > 0 AND nLogCount <= 500 THEN
                aTuningHistory[nLogCount].bRejected := FALSE;
            END_IF
            eState := E_TunerState.eWriteKp; // Start hardware write sequence
        ELSE
            IF nLogCount > 0 AND nLogCount <= 500 THEN
                aTuningHistory[nLogCount].bRejected := TRUE;
            END_IF
            // Skip this Ki since Tn is mathematically out of bounds
            eState := E_TunerState.eEvaluateResonance;
        END_IF

    E_TunerState.eWriteKp:
        fbCoEWrite.nIndex := 16#8011;
        fbCoEWrite.nSubIndex := 16#01;
        nCoEWriteBuffer := nCurrentKp;
        fbCoEWrite.pSrcBuf := ADR(nCoEWriteBuffer);
        fbCoEWrite.cbBufLen := SIZEOF(nCoEWriteBuffer);
        IF NOT fbCoEWrite.bExecute THEN
            fbCoEWrite.bExecute := TRUE;
        ELSIF NOT fbCoEWrite.bBusy AND NOT fbCoEWrite.bError THEN
            fbCoEWrite.bExecute := FALSE;
            eState := E_TunerState.eWriteKi;
        ELSIF fbCoEWrite.bError THEN
            nErrorId := fbCoEWrite.nErrId;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eWriteKi:
        fbCoEWrite.nIndex := 16#8011;
        fbCoEWrite.nSubIndex := 16#02;
        nCoEWriteBuffer := nCurrentKi;
        fbCoEWrite.pSrcBuf := ADR(nCoEWriteBuffer);
        fbCoEWrite.cbBufLen := SIZEOF(nCoEWriteBuffer);
        IF NOT fbCoEWrite.bExecute THEN
            fbCoEWrite.bExecute := TRUE;
        ELSIF NOT fbCoEWrite.bBusy AND NOT fbCoEWrite.bError THEN
            fbCoEWrite.bExecute := FALSE;
            eState := E_TunerState.eReadConfirmKp;
        ELSIF fbCoEWrite.bError THEN
            nErrorId := fbCoEWrite.nErrId;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eReadConfirmKp:
        fbCoERead.nIndex := 16#8011;
        fbCoERead.nSubIndex := 16#01;
        fbCoERead.pDstBuf := ADR(nTnCoEBuffer);
        fbCoERead.cbBufLen := SIZEOF(nTnCoEBuffer);
        IF NOT fbCoERead.bExecute THEN
            fbCoERead.bExecute := TRUE;
        ELSIF NOT fbCoERead.bBusy AND NOT fbCoERead.bError THEN
            fbCoERead.bExecute := FALSE;
            IF nTnCoEBuffer = nCurrentKp THEN
                eState := E_TunerState.eReadConfirmKi;
            ELSE
                nErrorId := 16#8011; // Kp Verification Failed
                eErrorSource := eState;
                eState := E_TunerState.eError;
            END_IF
        ELSIF fbCoERead.bError THEN
            nErrorId := fbCoERead.nErrId;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eReadConfirmKi:
        fbCoERead.nIndex := 16#8011;
        fbCoERead.nSubIndex := 16#02;
        fbCoERead.pDstBuf := ADR(nTnCoEBuffer);
        fbCoERead.cbBufLen := SIZEOF(nTnCoEBuffer);
        IF NOT fbCoERead.bExecute THEN
            fbCoERead.bExecute := TRUE;
        ELSIF NOT fbCoERead.bBusy AND NOT fbCoERead.bError THEN
            fbCoERead.bExecute := FALSE;
            IF nTnCoEBuffer = nCurrentKi THEN
                eState := E_TunerState.eMoveFwd; // Both verified, execute the move!
                MEMSET(ADR(aLoadData), 0, SIZEOF(aLoadData));
                MEMSET(ADR(aPowerData), 0, SIZEOF(aPowerData));
                fbMoveRelative.Distance := fTestDistance;
                fbMoveRelative.Execute := TRUE;
            ELSE
                nErrorId := 16#8012; // Ki Verification Failed
                eErrorSource := eState;
                eState := E_TunerState.eError;
            END_IF
        ELSIF fbCoERead.bError THEN
            nErrorId := fbCoERead.nErrId;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eMoveFwd:
        // Stall Protection
        IF stTuningInputs.bStall THEN
            fbMoveRelative.Execute := FALSE;
            _stAxis.stControl.bStop := TRUE; // Let FB_Axis safely halt the motor
            nErrorId := 16#7047; // Custom Stall ErrorID
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

        // Record high-speed arrays only during pure constant velocity
        IF fbReadStatus.ConstantVelocity THEN
            IF nSampleCount < 1000 THEN
                nSampleCount := nSampleCount + 1;
                aLoadData[nSampleCount] := stTuningInputs.nInfoData1;
                aPowerData[nSampleCount] := stTuningInputs.nInfoData2;
            END_IF
        END_IF

        IF fbMoveRelative.Done THEN
            fbMoveRelative.Execute := FALSE;
            eState := E_TunerState.eWaitMoveFwd;
        ELSIF fbMoveRelative.Error THEN
            nErrorId := fbMoveRelative.ErrorID;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eWaitMoveFwd:
        // Delay before returning
        fbSettleTimer(IN := TRUE, PT := T#500MS);
        IF fbSettleTimer.Q THEN
            fbSettleTimer(IN := FALSE);
            fbMoveRelative.Distance := -fTestDistance;
            fbMoveRelative.Execute := TRUE;
            eState := E_TunerState.eMoveBwd;
        END_IF

    E_TunerState.eMoveBwd:
        // Stall Protection
        IF stTuningInputs.bStall THEN
            fbMoveRelative.Execute := FALSE;
            _stAxis.stControl.bStop := TRUE; // Let FB_Axis safely halt the motor
            nErrorId := 16#7047; // Custom Stall ErrorID
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

        // Record high-speed arrays only during pure constant velocity
        IF fbReadStatus.ConstantVelocity THEN
            IF nSampleCount < 1000 THEN
                nSampleCount := nSampleCount + 1;
                aLoadData[nSampleCount] := stTuningInputs.nInfoData1;
                aPowerData[nSampleCount] := stTuningInputs.nInfoData2;
            END_IF
        END_IF

        IF fbMoveRelative.Done THEN
            fbMoveRelative.Execute := FALSE;
            IF bExecuteSingleTest THEN
                bExecuteSingleTest := FALSE; // Auto-untoggle HMI button
                eState := E_TunerState.eIdle;
                bBusy := FALSE;
                bDone := TRUE;
            ELSE
                eState := E_TunerState.eEvaluateResonance;
            END_IF
        ELSIF fbMoveRelative.Error THEN
            nErrorId := fbMoveRelative.ErrorID;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eEvaluateResonance:
        // Calculate Variance of the Load Angle (Data is guaranteed to be purely Constant Velocity)
        fCurrentResonance := 0.0;
        IF nSampleCount > 1 THEN
            // 1. Calculate the Mean
            fSum := 0.0;
            FOR i := 1 TO nSampleCount DO
                fSum := fSum + INT_TO_LREAL(aLoadData[i]);
            END_FOR
            fMean := fSum / UINT_TO_LREAL(nSampleCount);

            // 2. Calculate Variance (Sum of Squared Differences)
            fVarianceSum := 0.0;
            FOR i := 1 TO nSampleCount DO
                fDiff := INT_TO_LREAL(aLoadData[i]) - fMean;
                fVarianceSum := fVarianceSum + (fDiff * fDiff);
            END_FOR

            // The score is the variance. Lower is mathematically smoother.
            fCurrentResonance := fVarianceSum / UINT_TO_LREAL(nSampleCount);

            // Save the physical score to the log history
            IF nLogCount > 0 AND nLogCount <= 500 THEN
                aTuningHistory[nLogCount].fResonanceScore := fCurrentResonance;
            END_IF

            // Save if it's the smoothest run yet
            IF fCurrentResonance < fBestResonanceScore THEN
                fBestResonanceScore := fCurrentResonance;
                nBestKp := nCurrentKp;
                nBestKi := nCurrentKi;
                MEMCPY(ADR(aBestLoadData), ADR(aLoadData), SIZEOF(aLoadData));
            END_IF

            // Save if it's the worst run
            IF fCurrentResonance > fWorstResonanceScore THEN
                fWorstResonanceScore := fCurrentResonance;
                MEMCPY(ADR(aWorstLoadData), ADR(aLoadData), SIZEOF(aLoadData));
            END_IF
        END_IF

        // Loop iteration logic
        nCurrentKi := nCurrentKi + nKiStep;
        IF nCurrentKi <= nKiEnd THEN
            eNextState := E_TunerState.eEvaluateTn; // Re-evaluate Tn for the new Ki
        ELSE
            nIteration := nIteration + 1;
            IF nIteration <= nMaxKpIterations THEN
                nCurrentKp := LREAL_TO_UINT(UINT_TO_LREAL(nCurrentKp) * (1.0 - (fKpReductionPct / 100.0)));
                nCurrentKi := nKiStart;
                eNextState := E_TunerState.eEvaluateTn; // Re-evaluate Tn for the new Kp/Ki
            ELSE
                eNextState := E_TunerState.eApplyBestParams;
            END_IF
        END_IF

        // Only pause in Step Mode if we actually recorded real physical data
        IF bStepMode AND nSampleCount > 1 THEN
            eState := E_TunerState.eWaitNextStep;
        ELSE
            eState := eNextState;
        END_IF

    E_TunerState.eWaitNextStep:
        bIterationReady := TRUE;

        IF bNextStep THEN
            bNextStep := FALSE;
            bIterationReady := FALSE;
            eState := eNextState;
        ELSIF bAbortTuning THEN
            bAbortTuning := FALSE;
            bIterationReady := FALSE;
            eState := E_TunerState.eIdle;
        END_IF

    E_TunerState.eApplyBestParams:
        // Optimization complete.
        // We populate the manual apply inputs with the winner, so the user can review and click apply.
        nApplyKp := nBestKp;
        nApplyKi := nBestKi;
        nApplyMaxCurrent := nCurrentRunMaxCurrent;
        bExecuteAutoTune := FALSE; // Auto-untoggle HMI button
        bBusy := FALSE;
        bDone := TRUE;
        eState := E_TunerState.eIdle;

    E_TunerState.eApplyManualCurrent:
        fbCoEWrite.nIndex := 16#8010;
        fbCoEWrite.nSubIndex := 16#01;
        nCoEWriteBuffer := nApplyMaxCurrent;
        fbCoEWrite.pSrcBuf := ADR(nCoEWriteBuffer);
        fbCoEWrite.cbBufLen := SIZEOF(nCoEWriteBuffer);
        IF NOT fbCoEWrite.bExecute THEN
            fbCoEWrite.bExecute := TRUE;
        ELSIF NOT fbCoEWrite.bBusy AND NOT fbCoEWrite.bError THEN
            fbCoEWrite.bExecute := FALSE;
            eState := E_TunerState.eApplyManualKp;
        ELSIF fbCoEWrite.bError THEN
            nErrorId := fbCoEWrite.nErrId;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eApplyManualKp:
        fbCoEWrite.nIndex := 16#8011;
        fbCoEWrite.nSubIndex := 16#01;
        nCoEWriteBuffer := nApplyKp;
        fbCoEWrite.pSrcBuf := ADR(nCoEWriteBuffer);
        fbCoEWrite.cbBufLen := SIZEOF(nCoEWriteBuffer);
        IF NOT fbCoEWrite.bExecute THEN
            fbCoEWrite.bExecute := TRUE;
        ELSIF NOT fbCoEWrite.bBusy AND NOT fbCoEWrite.bError THEN
            fbCoEWrite.bExecute := FALSE;
            eState := E_TunerState.eApplyManualKi;
        ELSIF fbCoEWrite.bError THEN
            nErrorId := fbCoEWrite.nErrId;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eApplyManualKi:
        fbCoEWrite.nIndex := 16#8011;
        fbCoEWrite.nSubIndex := 16#02;
        nCoEWriteBuffer := nApplyKi;
        fbCoEWrite.pSrcBuf := ADR(nCoEWriteBuffer);
        fbCoEWrite.cbBufLen := SIZEOF(nCoEWriteBuffer);
        IF NOT fbCoEWrite.bExecute THEN
            fbCoEWrite.bExecute := TRUE;
        ELSIF NOT fbCoEWrite.bBusy AND NOT fbCoEWrite.bError THEN
            fbCoEWrite.bExecute := FALSE;
            bApplyParams := FALSE; // Reset trigger
            bBusy := FALSE;
            bDone := TRUE;
            eState := E_TunerState.eIdle;
        ELSIF fbCoEWrite.bError THEN
            nErrorId := fbCoEWrite.nErrId;
            eErrorSource := eState;
            eState := E_TunerState.eError;
        END_IF

    E_TunerState.eError:
        bBusy := FALSE;
        bError := TRUE;
        fbCoERead.bExecute := FALSE;
        fbCoEWrite.bExecute := FALSE;
        fbMoveRelative.Execute := FALSE;

        IF bAbortTuning THEN
            bAbortTuning := FALSE;
            bExecuteAutoTune := FALSE; // Prevent runaway restarts
            bExecuteSingleTest := FALSE;
            bApplyParams := FALSE;
            bError := FALSE;
            nErrorId := 0;
            eState := E_TunerState.eIdle;
        ELSIF bContinueAfterError THEN
            bContinueAfterError := FALSE;
            bError := FALSE;
            bBusy := TRUE;
            nErrorId := 0;
            eState := eErrorSource; // Retry the exact step that failed
        END_IF
END_CASE
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>